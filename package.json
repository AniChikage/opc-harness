{
  "name": "opc-harness",
  "version": "0.5.0",
  "description": "A project-local website delivery harness for Codex and Claude Code",
  "homepage": "https://github.com/AniChikage/opc-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniChikage/opc-harness.git"
  },
  "bugs": {
    "url": "https://github.com/AniChikage/opc-harness/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "harness",
    "skills",
    "cloudflare",
    "stripe"
  ],
  "type": "module",
  "bin": {
    "opc": "bin/opc.mjs",
    "opc-harness": "bin/opc.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "skills",
    "README.md",
    "CONTRIBUTING.md",
    "docs",
    "npm-shrinkwrap.json",
    "LICENSE",
    "scripts/check-syntax.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "wrangler": "4.156.2"
  },
  "license": "MIT"
}
