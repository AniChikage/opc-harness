{
  "name": "opc-harness",
  "version": "0.5.0",
  "description": "A project-local website delivery harness for Codex and Claude Code",
  "homepage": "https://github.com/AniChikage/opc-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniChikage/opc-harness.git"
  },
  "bugs": {
    "url": "https://github.com/AniChikage/opc-harness/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "harness",
    "skills",
    "cloudflare",
    "stripe"
  ],
  "type": "module",
  "bin": {
    "opc": "bin/opc.mjs",
    "opc-harness": "bin/opc.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin/opc.mjs",
    "dist/bin/opc.mjs",
    "dist/src",
    "dist/templates",
    "dist/skills",
    "dist/scripts/check-syntax.mjs",
    "dist/package.json",
    "dist/npm-shrinkwrap.json",
    "README.md",
    "CONTRIBUTING.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node dist/scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.mjs",
    "check": "npm run typecheck && npm run build && node dist/scripts/check-syntax.mjs",
    "check:release": "npm run build && node dist/scripts/check-release.mjs",
    "test:package": "npm run build && node dist/scripts/smoke-package.mjs",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "wrangler": "4.156.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
