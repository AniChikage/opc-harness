{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "bin/**/*.mts",
    "src/**/*.mts",
    "scripts/**/*.mts",
    "test/**/*.mts",
    "templates/**/*.ts",
    "templates/**/*.mts",
    "types/**/*.d.ts",
    "web/assets/studio/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "notes",
    "examples"
  ]
}
