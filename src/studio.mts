import type { TemplateDefinition } from './types.mjs';
import { TEMPLATES, REFERENCES } from './catalog.mjs';
import { FRONTENDS, STACKS, PAYMENT_MODULES, RECIPES, frontendFor } from './modules.mjs';
import { escapeHTML as e } from './pages.mjs';
import { VERSION } from './core.mjs';

export function studioPage(ordered: TemplateDefinition[]) {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Finished website designs for one-person companies. See the actual layout, apply your brand, then let your agent build, verify and deploy it."><title>OPC Studio — Choose a finished website</title><link rel="stylesheet" href="/studio.css"><script src="/studio.js" type="module"></script></head><body><a class="skip" href="#main">Skip to templates</a><header class="topbar"><a class="wordmark" href="/" aria-label="OPC Harness studio"><svg viewBox="0 0 30 30" aria-hidden="true"><path d="M4 7h9v7H4zM17 7h9v7h-9zM4 18h9v7H4zM17 18h9v7h-9z" fill="currentColor"/></svg>OPC <span>Studio</span></a><span class="header-note">Finished designs, verified delivery</span><a class="source-link" href="https://github.com/AniChikage/opc-harness" target="_blank" rel="noopener noreferrer">GitHub</a><span class="version">${e(VERSION)}</span></header><div class="studio-shell"><aside class="sidebar"><p class="side-label">Catalogue</p><nav aria-label="Website types"><button data-filter="all" aria-pressed="true" class="active">All templates <span>${TEMPLATES.length}</span></button>${FRONTENDS.map((x) => `<button data-filter="${x.id}" aria-pressed="false">${e(x.name)}<span>${x.templates.length}</span></button>`).join("")}</nav><div class="side-bottom"><p>Or start from a recipe</p><label class="sr-only" for="recipe">Ready-made recipe</label><select id="recipe"><option value="">Build your combination</option>${RECIPES.map((x) => `<option value="${x.id}">${e(x.name)}</option>`).join("")}</select><p>One template, one stack, one payment choice.</p></div></aside><main id="main"><section class="intro"><span class="intro-tag">For one-person companies</span><h1>See the website.<br>Ship the result.</h1><p>${TEMPLATES.length} finished websites, each a complete design with working interactions. Pick one, make it yours, and let your agent build, verify and deploy it.</p><div class="catalog-meta"><span>${TEMPLATES.length} templates</span><span>${FRONTENDS.length} categories</span><span>${STACKS.length} stacks</span><span>${PAYMENT_MODULES.length} payment modes</span></div></section><div class="catalog-toolbar"><h2 id="category-title">All templates</h2><label class="catalog-search"><span class="sr-only">Search templates</span><input id="template-search" type="search" placeholder="Find a template or feature"></label></div><p id="catalog-count" class="sr-only" role="status"></p><div class="template-grid">${ordered
      .map(
        (t) =>
          `<article class="template-card" data-template="${t.id}" data-type="${frontendFor(t.id)!.id}"><button class="preview-button" data-preview="${t.id}" aria-label="Preview ${e(t.name)}"><div class="mini-browser" aria-hidden="true"><span></span><span></span><span></span><small>${e(t.brand.toLowerCase().replaceAll(" ", "-"))}.example</small></div><div class="preview-frame"><iframe loading="lazy" src="/templates/${t.id}/" title="${e(t.name)} website thumbnail" tabindex="-1" aria-hidden="true" sandbox="allow-scripts allow-same-origin"></iframe></div><span class="preview-label">Explore website</span></button><div class="card-content"><div class="card-title"><h3>${e(t.name)}</h3><span>${e(frontendFor(t.id)!.name)}</span></div><p>${e(t.description)}</p><div class="card-features">${t.features
            .slice(0, 3)
            .map((f) => `<span>${e(f)}</span>`)
            .join(
              "",
            )}</div><div class="card-actions"><button class="text-button" data-preview="${t.id}">Preview website</button><button class="choose-button" data-select="${t.id}" aria-pressed="false">Use template</button></div>${(REFERENCES[t.id] || []).map((r) => `<a class="card-reference" href="${e(r.url)}" target="_blank" rel="noopener noreferrer">Pattern reference: ${e(r.name)}</a>`).join("")}</div></article>`,
      )
      .join(
        "",
      )}</div><p id="no-templates" hidden>No templates match. Try another feature or website type.</p><footer class="catalog-footer">Previews and generated projects share one renderer and the same assets. Every build records a design lock, so the layout you chose cannot drift silently while brand and content stay editable. Reference websites are independent inspiration links; their source and assets are not copied.</footer></main><aside class="configuration" aria-labelledby="configuration-title"><div class="config-heading"><span class="selection-dot"></span><h2 id="configuration-title">Your build</h2><span id="selected-type"></span></div><div class="selection-summary"><h3 id="selected-name"></h3><p id="selected-description"></p><button class="text-button" id="preview-selection">Preview selected website</button></div><form id="project-form"><label>Project folder<input id="project" value="my-website" pattern="[a-z][a-z0-9\\-]{2,45}" maxlength="46" required></label><label>Brand name<input id="brand" maxlength="100" required></label><label>Headline<input id="headline" maxlength="300" required></label><details class="brand-details"><summary>More brand settings</summary><label>Description<input id="description" maxlength="800" required></label><label>Contact email<input id="email" type="email" value="hello@example.com" required></label><label>Accent color<input id="accent" type="color" value="#7354d3"></label></details><label>Run & deploy<select id="stack">${STACKS.map((x) => `<option value="${x.id}">${e(x.name)}</option>`).join("")}</select></label><p class="field-note" id="stack-note"></p><label>Payment<select id="payment">${PAYMENT_MODULES.map((x) => `<option value="${x.id}">${e(x.name)}</option>`).join("")}</select></label><p class="field-note" id="payment-note"></p><div id="product-settings" hidden><label>Price in minor units<input id="amount" type="number" value="1900" min="50" max="99999999" step="1" required></label><label>Currency<select id="currency"><option value="usd">USD</option><option value="eur">EUR</option><option value="gbp">GBP</option><option value="cny">CNY</option><option value="jpy">JPY</option><option value="cad">CAD</option><option value="aud">AUD</option></select></label><p class="field-note">For Stripe, configure a test Price with the same currency and amount. JPY uses whole yen.</p></div><details class="data-module"><summary>Data & content included</summary><p id="data-note"></p><p>Brand and content are configurable. User accounts and shared team data require an additional backend.</p></details><div class="module-status" role="status" id="compatibility"></div><button class="primary-button" type="submit">Copy create command</button><button class="secondary-button" type="button" id="download-config">Download project config</button></form><p id="copy-status" role="status"></p><details class="command-details"><summary>View command & agent prompt</summary><pre><code id="command"></code></pre><pre id="agent-prompt"></pre><button class="text-button" id="copy-prompt">Copy agent prompt</button></details><details class="reference-module" open><summary>Related example websites</summary><div id="references"></div><p>References help compare patterns. The selected OPC template is the exact reusable example.</p></details><p class="local-only">Configuration stays on this device. No accounts or deployments are created by this page.</p></aside></div><a class="mobile-config" href="#configuration-title">Configure your build</a><dialog class="preview-dialog" aria-labelledby="preview-title"><header><div><strong id="preview-title"></strong><span id="preview-info"></span></div><div class="device-switch" role="group" aria-label="Preview viewport"><button data-device="desktop" aria-pressed="true">Desktop</button><button data-device="mobile" aria-pressed="false">Mobile</button></div><a id="open-preview" target="_blank" rel="noopener">Open example</a><button id="close-preview" aria-label="Close website preview">Close</button></header><div class="live-preview"><iframe id="live-frame" title="Interactive website preview" sandbox="allow-scripts allow-same-origin allow-downloads allow-popups"></iframe></div><footer><p>Interact with the complete frontend. Checkout runs only in a generated project with its configured backend.</p><button class="primary-button" id="use-preview">Use this template</button></footer></dialog></body></html>`;
}
