import type { ResolvedSite } from './types.mjs';
import type { IndieTemplateId } from './indie-catalog.mjs';
import { escapeHTML as e } from './html.mjs';

const marks: Record<IndieTemplateId, string> = {
  petal: '<path d="M15 15C3 17 1 3 9 3c5 0 6 6 6 12Zm2 0C15 3 29 1 29 9c0 5-6 6-12 6Zm0 2c12-2 14 12 6 12-5 0-6-6-6-12Zm-2 0c2 12-12 14-12 6 0-5 6-6 12-6Z" fill="currentColor"/>',
  gauge: '<path d="m2 23 7-3v10H2Zm10-8 7-3v18h-7Zm10-9 8-4v28h-8Z" fill="currentColor"/>',
  scribble: '<path d="M6 3h15l7 7v19H6Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M20 3v8h8M6 18v11h11" fill="var(--accent, #2759bb)" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>',
  letterline: '<path d="M16 1v30M1 16h30M5.4 5.4l21.2 21.2M26.6 5.4 5.4 26.6" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  nocturne: '<circle cx="16" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="2"/><ellipse cx="16" cy="16" rx="17" ry="5.5" transform="rotate(-32 16 16)" fill="none" stroke="currentColor" stroke-width="1.6"/>',
};
export const indieMark = (id: IndieTemplateId) => `<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">${marks[id]}</svg>`;
const mark = indieMark;
const brand = (id: IndieTemplateId, s: ResolvedSite) => `<a class="brand" href="/">${mark(id)}<span>${e(s.brand)}</span></a>`;
const start = (label = 'Start a brief') => `<a class="button" href="/workspace.html">${e(label)}</a>`;
const heroActions = (id: IndieTemplateId) => id === 'gauge'
  ? `<form class="gauge-start" id="gauge-start"><label for="gauge-idea" class="sr-only">Your project idea</label><input id="gauge-idea" name="idea" placeholder="Your project idea" maxlength="3000" required><button class="button">Start a brief <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5"/></svg></button><p class="status" id="gauge-start-status" role="status">No account needed. Your draft stays local.</p></form><a class="preview-link" href="#preview">Try the sample plan</a>`
  : `<div class="hero-actions">${start()}<a class="preview-link" href="#preview">Try the preview</a></div>`;
const chevron = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg>';
const sample = { idea: 'A simple website for a weekend workshop.', audience: 'People who want to learn and get hands-on practice.', outcome: 'Help people sign up and show what to expect.' };
const steps = (id: IndieTemplateId) => `<div class="story-steps">${[
  ['Capture', 'Put your ideas, notes, and context in one place.'],
  ['Shape', 'Turn them into a clear, focused project brief.'],
  ['Share', 'Get a draft you can use, iterate on, and share.'],
].map(([title, copy], i) => `<div><span class="step-number">${id === 'nocturne' ? '0' : ''}${i + 1}</span><h3>${title}</h3><p>${copy}</p></div>`).join('')}</div>`;
const dots = '<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>';

function petal(s: ResolvedSite) {
  return `<section class="product-preview petal-window" id="preview" aria-label="Interactive brief editor">
    <div class="window-bar">${dots}<span class="brand">${mark('petal')}<span>${e(s.brand)}</span></span><span class="window-label">Brief editor</span></div>
    <div class="petal-editor"><article class="petal-paper"><div class="paper-label">Project idea · Sample</div><h2>Project brief</h2><h3>Overview</h3><p id="petal-result">A small reading notebook to keep the passages worth remembering close at hand.</p><h3>Goals</h3><ul><li>Keep one useful passage.</li><li>Write down why it matters.</li><li>Choose one thing to try.</li></ul><h3>Scope</h3><p>A focused first version. One notebook, one reader, one useful next step.</p></article>
    <div class="petal-tools"><div class="segmented" role="group" aria-label="Writing mode"><button data-petal-mode="clarify" aria-pressed="true">Clarify</button><button data-petal-mode="shorten" aria-pressed="false">Shorten</button><button data-petal-mode="checklist" aria-pressed="false">Checklist</button></div>
    <form id="petal-form"><label for="petal-note">Add a note</label><p>Start with a rough idea. Try a writing mode to give it structure.</p><textarea id="petal-note" name="idea" maxlength="3000" required rows="5">A small reading notebook to keep the passages worth remembering close at hand.</textarea><div class="editor-actions"><button type="button" class="quiet-button" id="petal-reset">Reset</button><button class="button">Apply</button></div><p class="status" id="petal-status" role="status">Local text tools. No AI service is called.</p></form>
    <button class="text-link" id="petal-continue">Continue with this idea</button></div></div></section>
    <section class="story" id="how"><h2>A quieter place for the first draft.</h2>${steps('petal')}<div class="final-action">${start()}</div></section>`;
}
function gauge(s: ResolvedSite) {
  const tasks = ['Finalize the project brief', 'Build the core changes', 'Review and make fixes', 'Prepare the release'];
  return `<section class="product-preview gauge-window" id="preview" aria-label="Interactive sample release plan"><aside class="gauge-rail"><span class="brand">${mark('gauge')}<span>${e(s.brand)}</span></span><a class="active" href="#release-tasks">Release plan</a><a href="/workspace.html">Brief workspace</a><span class="rail-note">Sample data<br>Changes stay on this page.</span></aside><div class="gauge-content"><div class="gauge-heading"><div><h2>Sample release plan</h2><p>A working checklist for the next useful version.</p></div><button class="quiet-button" id="gauge-reset">Reset sample</button></div>
    <div class="gauge-metrics"><div><span>Release readiness</span><strong id="gauge-percent">75%</strong></div><div><span>Tasks complete</span><strong id="gauge-complete">3 of 4</strong></div><div><span>Still to do</span><strong id="gauge-remaining">1 task</strong></div></div>
    <div class="gauge-chart"><div class="chart-heading"><h3>Readiness, step by step</h3><span>Computed from checked tasks</span></div><svg viewBox="0 0 680 150" role="img" aria-label="Readiness is 75 percent" id="gauge-chart"><path class="chart-grid" d="M35 20H660M35 70H660M35 120H660"/><text x="0" y="24">100</text><text x="10" y="74">50</text><text x="15" y="124">0</text><path id="gauge-area" d="M35 120 190 95 345 70 500 45 655 45V120Z" class="chart-area"/><path id="gauge-line" d="M35 120 190 95 345 70 500 45 655 45" class="chart-line"/></svg></div>
    <div class="task-heading"><h3 id="release-tasks">Release tasks</h3><label class="show-tasks"><input type="checkbox" id="gauge-show-done" checked> Show completed</label></div><div class="release-tasks">${tasks.map((task, i) => `<label class="release-task"><input type="checkbox" data-release-task ${i < 3 ? 'checked' : ''}><span>${task}</span><span class="task-state">${i < 3 ? 'Done' : 'To do'}</span></label>`).join('')}</div><p class="status" id="gauge-status" role="status">3 of 4 sample tasks complete.</p></div></section>
    <section class="story" id="how"><h2>Less guessing. More progress.</h2><div class="gauge-story"><div><p>A practical project brief brings the next version into focus. Start with the idea. See what matters. Keep the first release small.</p><div class="large-mark">${mark('gauge')}</div></div><ol><li><h3>Capture the plan</h3><p>Turn an idea into a focused project brief.</p></li><li><h3>Do the work</h3><p>Choose the few tasks your first version needs.</p></li><li><h3>Check readiness</h3><p>Review the complete experience, start to finish.</p></li><li><h3>Keep a copy</h3><p>Export the brief and take your next step.</p></li></ol></div><div class="final-action">${start()}</div></section>`;
}
const doodles = `<svg class="doodle pencil" viewBox="0 0 150 150" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m25 21 16-10 57 80 5 27-25-14Z M25 21l53 83M36 36l15-11M78 104l20-13M103 118c22 21 19-12 42-1M68 9l4-7M81 18l9-5"/></g></svg><svg class="doodle kite" viewBox="0 0 120 180" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m24 24 65-17 17 65-50 28Z M24 24l82 48M89 7 56 100c-27 31 41 16 24 52-4 10-17 16-25 18M54 111l-12-2 8 15 8-11 10 12"/></g></svg><svg class="doodle spark" viewBox="0 0 80 80" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m35 23 7 16 18 1-14 12 4 18-15-9-16 9 4-18L9 40l18-1Z M31 10l-2-8M57 17l5-8M65 31l10-3"/></g></svg>`;
function scribble() {
  return `<section class="product-preview scribble-sheet" id="preview" aria-label="Live three-question brief"><form id="scribble-form"><h2>Create a project brief</h2><p>Answer three short questions to turn your idea into a clear brief.</p>${(['idea', 'audience', 'outcome'] as const).map((field, i) => `<label for="scribble-${field}">${['Idea', 'Audience', 'Outcome'][i]} <span>${["What is the idea or project?", 'Who is it for?', 'What do you want it to achieve?'][i]}</span></label><textarea id="scribble-${field}" name="${field}" rows="2" maxlength="${[3000, 300, 500][i]}" required>${e(sample[field])}</textarea>`).join('')}<button class="button">Create brief</button><p class="status" id="scribble-status" role="status">Your words stay in this browser.</p></form>
    <aside class="scribble-preview"><h2>Brief preview</h2><p>A quick look at your project brief.</p><article><h3>Project brief</h3>${(['idea', 'audience', 'outcome'] as const).map(field => `<section><h4>${field[0].toUpperCase() + field.slice(1)}</h4><p data-brief-preview="${field}">${e(sample[field])}</p></section>`).join('')}</article></aside></section>
    <section class="story" id="how"><h2>Room for the rough version.</h2><div class="scribble-story"><div><h3>Write it down.</h3><p>Get your ideas out quickly with a simple, focused flow. You do not need a perfect plan to get started.</p></div><div><h3>Shape it up.</h3><p>Turn your answers into a clear, useful brief you can build on, share, and use as a starting point.</p></div></div><div class="final-action">${start()}</div></section>`;
}
function letterline() {
  return `<section class="letter-reading" id="preview" aria-label="Sample project notes"><p class="reading-intro">Good work begins with a clear note.</p><p>A brief does not have to be long. It needs an idea, a person it helps, and a useful place to start. Here are two small examples.</p><div class="letter-notes"><details open><summary><span>01</span> A better home for a reading habit ${chevron}</summary><div><p>A reading notebook for people who want to remember more of what they read. Save a passage, add a thought, and choose one idea to put into practice.</p><p>The first version needs just one reading list and a place for notes. Social feeds, recommendations, and streaks can wait.</p><button class="text-link" data-note="reading">Use this starting point</button></div></details><details><summary><span>02</span> A useful page for a weekend workshop ${chevron}</summary><div><p>A simple page for people looking for a hands-on workshop. Explain what they will make, what to bring, and how to reserve a place.</p><p>Start with one workshop and one clear next step. A full event platform can wait.</p><button class="text-link" data-note="workshop">Use this starting point</button></div></details></div><p class="status" id="letter-status" role="status">Sample notes. Yours can be completely different.</p></section>
    <section class="letter-end" id="how"><h2>Write a little.<br>Find your next step.</h2><p>Put the idea into words. Give it a small, useful scope. Take a brief you can build on.</p>${start()}</section>`;
}
function nocturne(s: ResolvedSite) {
  return `<section class="product-preview nocturne-stage" id="preview" aria-label="Animated brief walkthrough"><div class="walkthrough-controls" role="group" aria-label="Walkthrough steps">${['Capture', 'Shape', 'Share'].map((label, i) => `<button data-walkthrough-step="${i}" aria-pressed="${i === 0}"><span>0${i + 1}</span>${label}</button>`).join('')}</div><p id="walkthrough-caption">Put your thoughts in one place.</p><div class="nocturne-app">${dots}<div class="nocturne-app-layout"><aside><span class="brand">${mark('nocturne')}<span>${e(s.brand)}</span></span><span class="active">Project brief</span><span>Capture · Shape · Share</span><a href="/workspace.html">Open workspace</a></aside><div class="walkthrough-document"><div class="walkthrough-heading"><h2 id="walkthrough-title">A rough idea, written down.</h2><span>Sample walkthrough</span></div><div class="walkthrough-scene" data-scene="0"><label>A first thought</label><p>A reading notebook for the passages worth remembering.</p><label>The people it helps</label><p>Readers who want to put useful ideas into practice.</p><label>A useful outcome</label><p>Keep a passage. Add a thought. Try something new.</p></div><div class="walkthrough-scene" data-scene="1" hidden><label>One clear idea</label><h3>A calmer reading notebook</h3><p>Save the passages worth remembering and turn them into small, useful actions.</p><label>A focused first version</label><ul><li>One reading list</li><li>A place for a passage and a thought</li><li>One next action</li></ul></div><div class="walkthrough-scene" data-scene="2" hidden><label>A plan you can take with you</label><pre># A calmer reading notebook\n\n## Audience\nReaders with an idea to try.\n\n## First version\n- Save a passage\n- Add a thought\n- Choose a next action</pre><a class="button" href="/workspace.html">Make your own brief</a></div></div></div></div><div class="walkthrough-footer"><span id="walkthrough-progress" aria-hidden="true">01 / 03</span><button id="walkthrough-motion" class="text-link" aria-pressed="false">Pause animation</button><span>Interactive walkthrough · no video download</span></div></section>
    <section class="story" id="how"><h2>From a rough thought to a shared plan.</h2>${steps('nocturne')}<div class="final-action">${start()}</div></section>`;
}

const layouts: Record<IndieTemplateId, (site: ResolvedSite) => string> = { petal, gauge, scribble, letterline, nocturne };
export function indieFavicon(id: IndieTemplateId) {
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-2 -2 36 36" style="color:${{petal:'#b03d7c',gauge:'#b95032',scribble:'#17171b',letterline:'#17171b',nocturne:'#a87aef'}[id]}">${marks[id]}</svg>`;
}
export function renderIndiePage(id: IndieTemplateId, s: ResolvedSite) {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="${e(s.description)}"><meta name="referrer" content="no-referrer"><meta name="theme-color" content="${id === 'nocturne' ? '#08090b' : '#ffffff'}"><title>${e(s.brand)} — ${e(s.headline)}</title><link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/${id}.css"><script type="module" src="/indie.js"></script></head><body class="indie template-${id}" data-template="${id}" style="--accent:${e(s.accent)}"><a class="skip-link" href="#main">Skip to content</a><header class="header">${brand(id, s)}<nav aria-label="Main navigation"><a href="#how">How it works</a><a href="/workspace.html">Open workspace</a></nav></header><main id="main"><section class="indie-hero">${id === 'scribble' ? doodles : id === 'nocturne' ? `<div class="hero-mark">${mark(id)}</div>` : ''}<h1>${e(s.headline)}</h1><p data-site-description>${e(s.description)}</p>${heroActions(id)}</section>${layouts[id](s)}</main><footer class="footer">${brand(id, s)}<nav aria-label="Footer navigation"><a href="/workspace.html">Open workspace</a><a href="mailto:${e(s.contactEmail)}">Contact</a></nav></footer></body></html>`;
}
